<Project Sdk="Microsoft.NET.Sdk">

  <!-- Emulation core for the Xbox shell: a NativeAOT shared library exposing a C ABI (see XboxCore.cs). -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <OptimizationPreference>Speed</OptimizationPreference>
    <DefaultItemExcludes>$(DefaultItemExcludes);._*</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ryujinx.Audio\Ryujinx.Audio.csproj" />
    <ProjectReference Include="..\Ryujinx.Common\Ryujinx.Common.csproj" />
    <ProjectReference Include="..\Ryujinx.Cpu\Ryujinx.Cpu.csproj" />
    <ProjectReference Include="..\Ryujinx.Graphics.GAL\Ryujinx.Graphics.GAL.csproj" />
    <ProjectReference Include="..\Ryujinx.HLE\Ryujinx.HLE.csproj" />
  </ItemGroup>

  <!-- HLE finds services and syscalls through reflection; keep those assemblies whole until an rd.xml replaces this. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Ryujinx.HLE" />
    <TrimmerRootAssembly Include="Ryujinx.Horizon" />
    <TrimmerRootAssembly Include="Ryujinx.Horizon.Common" />
    <TrimmerRootAssembly Include="Ryujinx.Common" />
    <TrimmerRootAssembly Include="ARMeilleure" />
    <TrimmerRootAssembly Include="Ryujinx.Cpu" />
    <TrimmerRootAssembly Include="LibHac" />
  </ItemGroup>

</Project>
