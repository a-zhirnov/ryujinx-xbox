<!--
  NativeAOT runtime directives for the Xbox core.
  ARMeilleure looks its helpers up with typeof(T).GetMethod(...) and HLE discovers services and syscalls through
  reflection, so these assemblies keep full metadata. Helper entry points themselves come from Delegates.cs.
-->
<Directives xmlns="http://schemas.microsoft.com/netfx/2013/01/metadata">
  <Application>
    <Assembly Name="ARMeilleure" Dynamic="Required All" />
    <Assembly Name="Ryujinx.Cpu" Dynamic="Required All" />
    <Assembly Name="Ryujinx.HLE" Dynamic="Required All" />
    <Assembly Name="Ryujinx.Horizon" Dynamic="Required All" />
  </Application>
</Directives>
